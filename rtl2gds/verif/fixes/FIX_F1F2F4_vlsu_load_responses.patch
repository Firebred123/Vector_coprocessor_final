diff --git a/rtl/execution/vlsu.sv b/rtl/execution/vlsu.sv
index c85c08b..1c425e5 100644
--- a/rtl/execution/vlsu.sv
+++ b/rtl/execution/vlsu.sv
@@ -43,6 +43,14 @@ module vlsu #(
     // With zero-latency memory, we get result same cycle as request
     // So we only need to count requests, not wait for results
     logic [3:0] req_cnt_q;
+    // FIX F1/F2/F4 (rtl-review): count responses separately from requests.
+    // Load completes on the 8th response (not on a request/ready condition),
+    // and each response is stored at its own index, so element 7 is no longer
+    // lost, completion does not depend on xif_mem_ready_i, and the index can
+    // never underflow/overflow for any memory latency.
+    logic [3:0] rsp_cnt_q;
+    logic       rsp_fire;
+    logic       all_rsp;
     
     // Data
     logic [31:0] base_addr_q;
@@ -67,12 +75,16 @@ module vlsu #(
     // All done when we've sent all requests
     logic all_done;
     assign all_done = (req_cnt_q >= WORDS_PER_VECTOR);
+    assign rsp_fire = (first_load || state == LOAD_ACTIVE) &&
+                      xif_mem_result_valid_i && (xif_mem_result_i.id == id_i);
+    assign all_rsp  = rsp_fire && (rsp_cnt_q == 4'(WORDS_PER_VECTOR - 1));
     
     // State machine
     always_ff @(posedge clk_i or negedge rst_ni) begin
         if (!rst_ni) begin
             state <= IDLE;
             req_cnt_q <= '0;
+            rsp_cnt_q <= '0;
             base_addr_q <= '0;
             load_data_q <= '0;
             store_data_q <= '0;
@@ -92,22 +104,17 @@ module vlsu #(
                 req_cnt_q <= req_cnt_q + 1;
             end
             
-            // Capture load results - with zero latency, result comes same cycle as request
-            if ((first_load || state == LOAD_ACTIVE) && 
-                xif_mem_result_valid_i && xif_mem_result_i.id == id_i) begin
-                // Use req_cnt_q-1 because we already incremented the counter
-                logic [3:0] result_idx;
-                if (first_load) begin
-                    result_idx = 0;
-                end else begin
-                    result_idx = req_cnt_q - 1;
-                end
-                load_data_q[result_idx * 32 +: 32] <= xif_mem_result_i.rdata;
+            // Capture load responses in arrival order (X-IF returns them in order)
+            if (first_load) rsp_cnt_q <= rsp_fire ? 4'd1 : 4'd0;
+            else if (rsp_fire) rsp_cnt_q <= rsp_cnt_q + 4'd1;
+            if (rsp_fire) begin
+                load_data_q[(first_load ? 3'd0 : rsp_cnt_q[2:0]) * 32 +: 32] <= xif_mem_result_i.rdata;
             end
             
             // Reset on completion
             if (next_state == IDLE && state != IDLE) begin
                 req_cnt_q <= '0;
+                rsp_cnt_q <= '0;
             end
         end
     end
@@ -116,12 +123,8 @@ module vlsu #(
     always_comb begin
         load_data_o = load_data_q;
         // Include current cycle's result
-        if ((first_load || state == LOAD_ACTIVE) && 
-            xif_mem_result_valid_i && xif_mem_result_i.id == id_i) begin
-            logic [3:0] idx;
-            if (first_load) idx = 0;
-            else idx = req_cnt_q - 1;
-            load_data_o[idx * 32 +: 32] = xif_mem_result_i.rdata;
+        if (rsp_fire) begin
+            load_data_o[(first_load ? 3'd0 : rsp_cnt_q[2:0]) * 32 +: 32] = xif_mem_result_i.rdata;
         end
     end
     
@@ -136,11 +139,8 @@ module vlsu #(
             end
             
             LOAD_ACTIVE: begin
-                // With zero-latency, we're done when last request is sent AND result received
-                if (req_cnt_q >= WORDS_PER_VECTOR - 1 && xif_mem_ready_i && 
-                    xif_mem_result_valid_i) begin
-                    next_state = IDLE;
-                end
+                // Done when the last (8th) response arrives
+                if (all_rsp) next_state = IDLE;
             end
             
             STORE_ACTIVE: begin
@@ -155,8 +155,7 @@ module vlsu #(
     end
     
     // Done signal
-    assign done_o = (state == LOAD_ACTIVE && req_cnt_q >= WORDS_PER_VECTOR - 1 && 
-                     xif_mem_ready_i && xif_mem_result_valid_i) ||
+    assign done_o = (state == LOAD_ACTIVE && all_rsp) ||
                     (state == STORE_ACTIVE && req_cnt_q >= WORDS_PER_VECTOR - 1 && 
                      xif_mem_ready_i);
     
